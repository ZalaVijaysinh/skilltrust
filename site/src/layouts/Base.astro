---
interface Props { title: string; description?: string }
const { title, description = "What each public Claude skill can do to your computer, explained in plain English." } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="top">
      <a class="brand" href={`${base}/`}>SkillTrust</a>
      <nav aria-label="Main">
        <a href={`${base}/`}>Skills</a>
        <a href={`${base}/how-we-score/`}>How we score</a>
        <a href={`${base}/report/`}>Report</a>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer>
      <p>SkillTrust reads the public files of Claude skills and lists what they can do. It does not run them, and it cannot prove a skill is safe. <a href={`${base}/how-we-score/#limits`}>Read the limits.</a></p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --bg: #faf8f4; --fg: #1d1b18; --muted: #5d574f; --line: #dcd6cb; --card: #fffdf9; --link: #0b4fa3;
    --low: #146c2e; --low-bg: #e1f2e5; --review: #8a4b00; --review-bg: #fbecd0; --high: #a1161c; --high-bg: #fbe0e0;
    --focus: #0b4fa3;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #141310; --fg: #eeeae2; --muted: #b0a99d; --line: #3a362f; --card: #1c1a16; --link: #8fbaf5;
      --low: #7fd59a; --low-bg: #16301f; --review: #f0bf6d; --review-bg: #38290f; --high: #ff9b9b; --high-bg: #3d1618;
      --focus: #8fbaf5;
    }
  }
  * { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--fg); line-height: 1.55;
    font: 16px/1.55 ui-serif, "Iowan Old Style", Charter, Georgia, serif;
  }
  a { color: var(--link); text-underline-offset: 2px; }
  :focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; border-radius: 2px; }
  .skip { position: absolute; left: -999px; background: var(--card); padding: .5rem 1rem; }
  .skip:focus { left: 16px; top: 8px; z-index: 10; }
  header.top, main, footer { max-width: 60rem; margin: 0 auto; padding-left: 16px; padding-right: 16px; }
  header.top { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; justify-content: space-between; align-items: baseline; padding-top: 1.25rem; padding-bottom: 1rem; border-bottom: 1px solid var(--line); }
  .brand { font: 700 1.25rem ui-sans-serif, system-ui, sans-serif; color: var(--fg); text-decoration: none; letter-spacing: -.01em; }
  header nav { display: flex; gap: 1.25rem; font: 500 .95rem ui-sans-serif, system-ui, sans-serif; }
  header nav a { color: var(--fg); padding: .35rem 0; }
  main { padding-top: 2rem; padding-bottom: 3rem; }
  footer { padding-bottom: 3rem; color: var(--muted); font-size: .9rem; border-top: 1px solid var(--line); padding-top: 1rem; }
  h1 { font-size: clamp(1.8rem, 6vw, 2.8rem); line-height: 1.1; letter-spacing: -.02em; margin: 0 0 .75rem; }
  h2 { font-size: 1.35rem; margin: 2.25rem 0 .75rem; letter-spacing: -.01em; }
  h3 { font-size: 1.05rem; margin: 0 0 .25rem; }
  .lede { font-size: 1.15rem; color: var(--muted); max-width: 40rem; margin: 0 0 1.5rem; }
  .sans, .badge, .chip, table, button, select, label { font-family: ui-sans-serif, system-ui, sans-serif; }
  .muted { color: var(--muted); }
  .badge { display: inline-flex; align-items: baseline; gap: .4rem; padding: .15rem .6rem; border-radius: 999px; font-size: .85rem; font-weight: 600; white-space: nowrap; border: 1px solid currentColor; }
  .badge b { font-size: 1rem; font-variant-numeric: tabular-nums; }
  .band-low { color: var(--low); background: var(--low-bg); }
  .band-review { color: var(--review); background: var(--review-bg); }
  .band-high { color: var(--high); background: var(--high-bg); }
  .chip { display: inline-block; font-size: .78rem; padding: .05rem .5rem; border-radius: 4px; border: 1px solid var(--line); color: var(--muted); margin-right: .35rem; }
  .notice { border-left: 4px solid var(--review); background: var(--review-bg); color: var(--fg); padding: .75rem 1rem; margin: 1rem 0; font-family: ui-sans-serif, system-ui, sans-serif; font-size: .95rem; }
  .controls { display: flex; flex-wrap: wrap; gap: .75rem 1rem; margin: 1.25rem 0; }
  .controls label { display: grid; gap: .2rem; font-size: .8rem; color: var(--muted); }
  select, button { font-size: 1rem; padding: .5rem .6rem; border: 1px solid var(--line); background: var(--card); color: var(--fg); border-radius: 6px; min-height: 44px; }
  button { cursor: pointer; font-weight: 600; }
  ul.rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: auto 1fr; gap: .25rem 1rem; padding: .9rem 0; border-bottom: 1px solid var(--line); color: var(--fg); text-decoration: none; align-items: start; }
  .row:hover .name { text-decoration: underline; }
  .row .badge { grid-row: span 2; align-self: center; }
  .name { font-weight: 700; font-size: 1.05rem; overflow-wrap: anywhere; }
  .meta { font: .85rem ui-sans-serif, system-ui, sans-serif; color: var(--muted); overflow-wrap: anywhere; }
  .finding { border: 1px solid var(--line); background: var(--card); border-radius: 8px; padding: .9rem 1rem; margin: .75rem 0; }
  .finding p { margin: .25rem 0; }
  code, pre { font: .85rem ui-monospace, SFMono-Regular, Menlo, monospace; }
  pre { background: var(--card); border: 1px solid var(--line); padding: .75rem; overflow-x: auto; border-radius: 6px; white-space: pre-wrap; overflow-wrap: anywhere; }
  .excerpt { display: block; overflow-wrap: anywhere; color: var(--muted); }
  table { border-collapse: collapse; width: 100%; font-size: .92rem; }
  th, td { text-align: left; padding: .5rem .5rem .5rem 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .tablewrap { overflow-x: auto; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr)); gap: .75rem; margin: 1rem 0; }
  .stat { border: 1px solid var(--line); background: var(--card); border-radius: 8px; padding: .75rem; font-family: ui-sans-serif, system-ui, sans-serif; }
  .stat b { display: block; font-size: 1.6rem; font-variant-numeric: tabular-nums; }
  .back { font: .9rem ui-sans-serif, system-ui, sans-serif; }
</style>
