---
import { bandLabel } from "../../../scanner/src/score";
import { skillHref, repoHref, ruleSentence } from "../lib/view";
import type { TrendingCard } from "../../../scanner/src/trending";
interface Props { card: TrendingCard; rising: boolean; window: 7 | 30; names: Map<string, string> }
const { card, rising, window, names } = Astro.props;
const stars = (n: number) => n.toLocaleString("en-US");
const risky = card.riskiest;
---
<li class="tcard">
  <div class="thead">
    <h3><a href={repoHref(card.owner, card.repo)}>{card.owner}/{card.repo}</a></h3>
    <span class={`badge band-${card.band}`}>{bandLabel(card.band)}</span>
  </div>
  <p class="meta">
    {rising
      ? <>★ {stars(card.stars)} stars · created {card.ageDays} {card.ageDays === 1 ? "day" : "days"} ago</>
      : <><b>+{stars(card.gained)} this {window === 7 ? "week" : "month"}</b> · ★ {stars(card.stars)} stars</>}
  </p>
  <ul class="tskills">
    {card.skills.map((s) => (
      <li><a href={skillHref(s.id)}>{s.name}</a> <span class="meta">{s.score}/100{s.incomplete && " · Partially scanned"}</span></li>
    ))}
    {card.moreSkills > 0 && <li class="meta">and {card.moreSkills} more</li>}
  </ul>
  {risky.ruleIds.length > 0 && (
    <p class="meta">Riskiest skill: <a href={skillHref(risky.id)}>{names.get(risky.id) ?? risky.id}</a>. It can:</p>
    <ul class="tcan">{risky.ruleIds.map((r) => <li>{ruleSentence(r)}</li>)}</ul>
  )}
</li>
