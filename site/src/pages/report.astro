---
import Base from "../layouts/Base.astro";
import { loadData } from "../lib/data";
import { RULES } from "../../../scanner/src/rules";
import { bandLabel } from "../../../scanner/src/score";
const { report } = loadData();
const plain = (s: string) => s.replace(/:?\s*\{hosts\}/, "");
const cats = report ? Object.entries(report.byCategory).sort((a, b) => b[1] - a[1]) : [];
---
<Base title="State of Claude skill safety | SkillTrust">
  <h1>State of Claude skill safety</h1>
  {!report || report.totalSkills === 0 ? (
    <p class="notice">First scan in progress. The report appears once the first scan finishes.</p>
  ) : (
    <>
      <p class="lede">{report.totalSkills} skills from {report.totalRepos} repositories, scanned {report.generatedAt.slice(0, 10)}.</p>
      <div class="stats">
        {(["low", "review", "high"] as const).map((b) => (
          <div class="stat"><b>{report.byBand[b]}</b>{bandLabel(b)}</div>
        ))}
      </div>
      <h2>What skills can do</h2>
      <div class="tablewrap">
        <table>
          <thead><tr><th>Capability</th><th>Skills</th><th>Share</th><th>Disclosed by author</th></tr></thead>
          <tbody>
            {RULES.map((r) => (
              <tr><td>{plain(r.sentence)}</td><td>{report.byRule[r.id].count}</td><td>{report.byRule[r.id].percent}%</td><td>{report.byRule[r.id].disclosed}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <h2>By category</h2>
      <div class="tablewrap">
        <table>
          <thead><tr><th>Category</th><th>Skills</th></tr></thead>
          <tbody>{cats.map(([c, n]) => <tr><td>{c}</td><td>{n}</td></tr>)}</tbody>
        </table>
      </div>
    </>
  )}
</Base>
